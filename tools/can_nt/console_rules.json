{
  "rules": [
    {
      "name": "CAN_BUS_UTIL_HIGH",
      "regex": "\\[CAN\\]\\s*High utilization[:]?\\s*([0-9.]+)%",
      "severity": "WARN",
      "scope": "system",
      "event_type": "CAN_BUS_UTIL_HIGH"
    },
    {
      "name": "CAN_BUS_UTIL_RECOVER",
      "regex": "\\[CAN\\]\\s*Utilization recovered[:]?\\s*([0-9.]+)%",
      "severity": "INFO",
      "scope": "system",
      "event_type": "CAN_BUS_UTIL_RECOVER"
    },
    {
      "name": "CAN_TIMEOUT",
      "regex": "CAN.*timeout.*device\\s+(\\d+)",
      "severity": "WARN",
      "scope": "device",
      "event_type": "CAN_TIMEOUT",
      "device_id_group": 1
    },
    {
      "name": "CAN_FRAME_TOO_STALE_DEVICE",
      "regex": "CAN frame not received/too-stale\\. Check the CAN bus wiring, CAN bus utilization, and power to the device\\..*\\s(\\d+)\\s+\\(.*\\)",
      "severity": "WARN",
      "scope": "device",
      "event_type": "CAN_FRAME_TOO_STALE",
      "device_id_group": 1
    },
    {
      "name": "CAN_FRAME_TOO_STALE",
      "regex": "CAN frame not received/too-stale\\. Check the CAN bus wiring, CAN bus utilization, and power to the device\\.",
      "severity": "WARN",
      "scope": "system",
      "event_type": "CAN_FRAME_TOO_STALE"
    },
    {
      "name": "LOOP_OVERRUN",
      "regex": "Loop time of\\s+\\d+\\.\\d+s overrun",
      "severity": "WARN",
      "scope": "system",
      "event_type": "LOOP_OVERRUN"
    },
    {
      "name": "CAN_ERROR_SPIKE",
      "regex": "\\[CAN\\]\\s*Error spike: rx=(\\d+) tx=(\\d+)\\s*\\(delta rx=(\\d+) tx=(\\d+)\\)",
      "severity": "WARN",
      "scope": "system",
      "event_type": "CAN_ERROR_SPIKE"
    },
    {
      "name": "SPARK_STATUS_TIMEOUT",
      "regex": "\\[Spark Max\\] IDs: (\\d+), timed out while waiting for (Frame Mgr: )?Period Status 0",
      "severity": "WARN",
      "scope": "device",
      "event_type": "SPARK_STATUS_TIMEOUT",
      "device_id_group": 1
    },
    {
      "name": "TALON_STATUS_SIGNAL_STALE",
      "regex": "CAN message is stale, data is valid but old\\..*talon fx\\s+(\\d+)\\s+\\(.*\\)\\s+Status Signal\\s+([A-Za-z0-9_]+)",
      "severity": "WARN",
      "scope": "device",
      "event_type": "TALON_STATUS_SIGNAL_STALE",
      "device_id_group": 1
    },
    {
      "name": "SPARK_FW_QUERY_FAIL",
      "regex": "\\[Spark Max\\] IDs: (\\d+), Unable to retrieve SPARK firmware version",
      "severity": "WARN",
      "scope": "device",
      "event_type": "SPARK_FW_QUERY_FAIL",
      "device_id_group": 1
    },
    {
      "name": "DEVICE_FW_QUERY_FAIL_DEVICE",
      "regex": "Device firmware could not be retrieved\\. Check that the device is running v6 firmware, the device ID is correct, the specified CAN bus is correct, and the device is powered\\..*\\s(\\d+)\\s+\\(.*\\)",
      "severity": "WARN",
      "scope": "device",
      "event_type": "DEVICE_FW_QUERY_FAIL",
      "device_id_group": 1
    },
    {
      "name": "DEVICE_FW_QUERY_FAIL",
      "regex": "Device firmware could not be retrieved\\. Check that the device is running v6 firmware, the device ID is correct, the specified CAN bus is correct, and the device is powered\\.",
      "severity": "WARN",
      "scope": "system",
      "event_type": "DEVICE_FW_QUERY_FAIL"
    },
    {
      "name": "SPARK_WRONG_DEVICE",
      "regex": "CANSparkMax object created for CAN ID (\\d+), which is not a SPARK MAX",
      "severity": "WARN",
      "scope": "device",
      "event_type": "SPARK_WRONG_DEVICE",
      "device_id_group": 1
    },
    {
      "name": "PDP_STATUS_READER_TIMEOUT",
      "regex": "Error at frc\\.robot\\.manufacturers\\.ctre\\.util\\.PdpStatusReader(?:\\.snapshot|\\$WpiPowerDistributionAccess\\.(?:getCurrent|getVoltage|getTotalCurrent))",
      "severity": "ERROR",
      "scope": "device",
      "event_type": "PDP_STATUS_READER_TIMEOUT",
      "device_label": "pdp"
    },
    {
      "name": "PDH_STATUS_READER_TIMEOUT",
      "regex": "Error at frc\\.robot\\.manufacturers\\.rev\\.util\\.PdhStatusReader\\.snapshot",
      "severity": "ERROR",
      "scope": "device",
      "event_type": "PDH_STATUS_READER_TIMEOUT",
      "device_label": "pdh"
    },
    {
      "name": "HAL_CAN_RECEIVE_TIMEOUT",
      "regex": "HAL:\\s*CAN Receive has Timed Out",
      "severity": "ERROR",
      "scope": "system",
      "event_type": "HAL_CAN_RECEIVE_TIMEOUT"
    },
    {
      "name": "CAN_MESSAGE_NOT_FOUND",
      "regex": "^CAN:\\s*Message not found$",
      "severity": "WARN",
      "scope": "system",
      "event_type": "CAN_MESSAGE_NOT_FOUND"
    }
  ]
}
