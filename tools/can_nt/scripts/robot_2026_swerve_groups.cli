configure terminal
profile robot_2026

group swerve_front_left
member assign "angle motor front left"
member assign "Drive Motor"
member assign "Encoder (CANCoder)"
exit

group swerve_front_right
member assign "angle motor front right"
member assign "Drive Motor (id 2)"
member assign "Encoder (CANCoder) (id 3)"
exit

group swerve_back_left
member assign "angle motor back left"
member assign "Drive Motor (id 11)"
member assign "Encoder (CANCoder) (id 12)"
exit

group swerve_back_right
member assign "angle motor back right"
member assign "Drive Motor (id 8)"
member assign "Encoder (CANCoder) (id 9)"
exit

show groups
show group swerve_front_left
show group swerve_front_right
show group swerve_back_left
show group swerve_back_right

# Uncomment to persist to the default profiles file
save profiles data/bringup_system.json
end

