          "title": "Supported Devices",
          "summary": "Currently supported DSL device families, what they do, and which signals they expose.",
          "children": [
            {
              "id": "topic_device_type_encoderExternal",
              "title": "encoderExternal",
              "summary": "External encoder devices used to measure rotation and accumulated position change.",
              "syntax": [
                "device \"<label>\"  # resolves to DSL type encoderExternal"
              ],
              "details": [
                "Use this when motion proof comes from an external encoder instead of an integrated motor sensor.",
                "The aggregate `position_delta_max_abs` signal is useful for proving motion over the whole run."
              ],
              "signals": [
                "- position: number | read",
                "- position_actual: number | read",
                "- position_delta: number | read",
                "- position_delta_max_abs: number | read",
                "- velocity: number | read",
                "- velocity_actual: number | read",
                "- velocity_actual_max_abs: number | read"
              ],
              "examples": [
                "device \"driveEncoder0\"",
                "main:",
                "    until timer.elapsed >= 3.0",
                "    require \"driveEncoder0\".position_delta_max_abs > 5.0"
              ],
              "sourcePath": "src/main/java/frc/robot/tests/dsl/signals/encoderExternal.devices.md"
            },
            {
              "id": "topic_device_type_imu",
              "title": "imu",
              "summary": "Inertial measurement devices used for orientation evidence without commanding motion directly.",
              "syntax": [
                "device \"<label>\"  # resolves to DSL type imu"
              ],
              "details": [
                "Use this for configured devices whose logical DSL type resolves to `imu`, such as `Pigeon`.",
                "`yaw`, `pitch`, and `roll` are live absolute readings from the runtime snapshot.",
                "`yaw_delta`, `pitch_delta`, and `roll_delta` compare the current reading to the value captured at test start.",
                "Aggregate signals such as `yaw_delta_max_abs` prove that orientation changed sometime during the run.",
                "`angular_velocity_x`, `angular_velocity_y`, and `angular_velocity_z` are device-frame angular rates in degrees per second.",
                "`accel_x`, `accel_y`, and `accel_z` are accelerometer readings in G.",
                "`supply_voltage` reports the IMU supply rail in volts.",
                "`faults` is true when active or sticky IMU faults are reported and may be cleared with `clear \"device\".faults`."
              ],
              "signals": [
                "- accel_x: number | read",
                "- accel_y: number | read",
                "- accel_z: number | read",
                "- angular_velocity_x: number | read",
                "- angular_velocity_y: number | read",
                "- angular_velocity_z: number | read",
                "- faults: boolean | read, clear",
                "- pitch: number | read",
                "- pitch_delta: number | read",
                "- pitch_delta_max_abs: number | read",
                "- roll: number | read",
                "- roll_delta: number | read",
                "- roll_delta_max_abs: number | read",
                "- supply_voltage: number | read",
                "- yaw: number | read",
                "- yaw_delta: number | read",
                "- yaw_delta_max_abs: number | read"
              ],
              "examples": [
                "device \"pigeon 2\"",
                "main:",
                "    until timer.elapsed >= 2.0",
                "    require \"pigeon 2\".yaw_delta_max_abs > 5.0",
                "test \"pigeon_static_sanity\"",
                "device \"pigeon 2\"",
                "main:",
                "    until timer.elapsed >= 0.5",
                "    require \"pigeon 2\".angular_velocity_z < 2.0",
                "    require \"pigeon 2\".accel_z > 0.7",
                "    require \"pigeon 2\".supply_voltage > 10.0",
                "    require \"pigeon 2\".faults == false"
              ],
              "sourcePath": "src/main/java/frc/robot/tests/dsl/signals/imu.devices.md"
            },
